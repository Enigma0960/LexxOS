# Shared Pico SDK bootstrap for standalone RPI firmware components.
# Include this file before the project() command in each firmware CMakeLists.txt.

if (DEFINED PICO_SDK_PATH)
    string(STRIP "${PICO_SDK_PATH}" PICO_SDK_PATH)
    string(REGEX REPLACE "^\"|\"$" "" PICO_SDK_PATH "${PICO_SDK_PATH}")
    string(REGEX REPLACE "^'|'$" "" PICO_SDK_PATH "${PICO_SDK_PATH}")
    set(PICO_SDK_PATH "${PICO_SDK_PATH}" CACHE PATH "Path to the Raspberry Pi Pico SDK" FORCE)
endif ()

if (DEFINED PICO_TOOLCHAIN_PATH)
    string(STRIP "${PICO_TOOLCHAIN_PATH}" PICO_TOOLCHAIN_PATH)
    string(REGEX REPLACE "^\"|\"$" "" PICO_TOOLCHAIN_PATH "${PICO_TOOLCHAIN_PATH}")
    string(REGEX REPLACE "^'|'$" "" PICO_TOOLCHAIN_PATH "${PICO_TOOLCHAIN_PATH}")
    set(PICO_TOOLCHAIN_PATH "${PICO_TOOLCHAIN_PATH}" CACHE PATH "Path to the ARM GCC toolchain" FORCE)
endif ()
if (NOT DEFINED PICO_TOOLCHAIN_PATH OR PICO_TOOLCHAIN_PATH STREQUAL "")
    if (DEFINED ENV{PICO_TOOLCHAIN_PATH} AND NOT "$ENV{PICO_TOOLCHAIN_PATH}" STREQUAL "")
        set(PICO_TOOLCHAIN_PATH "$ENV{PICO_TOOLCHAIN_PATH}" CACHE PATH "Path to the ARM GCC toolchain")
    else ()
        file(GLOB_RECURSE _picolinux_pico_arm_gcc_candidates "$ENV{HOME}/.pico-sdk/toolchain/*/bin/arm-none-eabi-gcc")
        list(LENGTH _picolinux_pico_arm_gcc_candidates _picolinux_pico_arm_gcc_candidates_count)
        if (_picolinux_pico_arm_gcc_candidates_count GREATER 0)
            list(GET _picolinux_pico_arm_gcc_candidates 0 _picolinux_pico_arm_gcc)
            get_filename_component(_picolinux_pico_toolchain_bin "${_picolinux_pico_arm_gcc}" DIRECTORY)
            get_filename_component(_picolinux_pico_toolchain_root "${_picolinux_pico_toolchain_bin}" DIRECTORY)
            set(PICO_TOOLCHAIN_PATH "${_picolinux_pico_toolchain_root}" CACHE PATH "Path to the ARM GCC toolchain")
        endif ()
    endif ()
endif ()

if (NOT DEFINED PICO_SDK_PATH OR PICO_SDK_PATH STREQUAL "")
    if (DEFINED ENV{PICO_SDK_PATH} AND NOT "$ENV{PICO_SDK_PATH}" STREQUAL "")
        set(PICO_SDK_PATH "$ENV{PICO_SDK_PATH}" CACHE PATH "Path to the Raspberry Pi Pico SDK")
    elseif (EXISTS "$ENV{HOME}/.pico-sdk/sdk/2.2.0")
        set(PICO_SDK_PATH "$ENV{HOME}/.pico-sdk/sdk/2.2.0" CACHE PATH "Path to the Raspberry Pi Pico SDK")
    else ()
        file(GLOB _picolinux_pico_sdk_candidates "$ENV{HOME}/.pico-sdk/sdk/*")
        foreach (_picolinux_pico_sdk_candidate IN LISTS _picolinux_pico_sdk_candidates)
            if (EXISTS "${_picolinux_pico_sdk_candidate}/external/pico_sdk_import.cmake")
                set(PICO_SDK_PATH "${_picolinux_pico_sdk_candidate}" CACHE PATH "Path to the Raspberry Pi Pico SDK")
                break()
            endif ()
        endforeach ()
    endif ()
endif ()

if (NOT DEFINED PICO_SDK_PATH OR PICO_SDK_PATH STREQUAL "")
    message(FATAL_ERROR "PICO_SDK_PATH is not set. Example: export PICO_SDK_PATH=$HOME/.pico-sdk/sdk/2.2.0")
endif ()

include("${PICO_SDK_PATH}/external/pico_sdk_import.cmake")
