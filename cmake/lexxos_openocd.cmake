set(LEXXOS_OPENOCD_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL "LexxOS OpenOCD CMake module directory")
set(LEXXOS_OPENOCD_BUILD_SCRIPT "${LEXXOS_OPENOCD_MODULE_DIR}/../tools/scripts/lexxos-build-openocd.sh" CACHE FILEPATH "Local OpenOCD build script")
set(LEXXOS_OPENOCD_SOURCE_DIR "${LEXXOS_OPENOCD_MODULE_DIR}/../third_party/openocd" CACHE PATH "Local OpenOCD source directory")
set(LEXXOS_OPENOCD_BUILD_DIR "${CMAKE_BINARY_DIR}/tools/openocd-build" CACHE PATH "Local OpenOCD build directory")
set(LEXXOS_OPENOCD_INSTALL_DIR "${CMAKE_BINARY_DIR}/tools/openocd" CACHE PATH "Local OpenOCD install directory")
set(LEXXOS_OPENOCD_INTERFACE "interface/cmsis-dap.cfg" CACHE STRING "Default OpenOCD debug probe interface")
set(LEXXOS_OPENOCD_ADAPTER_SPEED "1000" CACHE STRING "Default OpenOCD adapter speed in kHz")
set(LEXXOS_BUILD_LOCAL_OPENOCD_WITH_FIRMWARE OFF CACHE BOOL "Build local OpenOCD before Pico firmware target")

function(lexxos_attach_local_openocd_dependency target_name)
    if (LEXXOS_PLATFORM STREQUAL "pico" AND LEXXOS_BUILD_LOCAL_OPENOCD_WITH_FIRMWARE)
        if (TARGET ${target_name} AND TARGET lexxos_openocd)
            add_dependencies(${target_name} lexxos_openocd)
        endif ()
    endif ()
endfunction()
