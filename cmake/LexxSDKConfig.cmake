if (TARGET LexxSDK::LexxSDK)
    return()
endif ()

get_filename_component(_lexx_sdk_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if (NOT LEXXOS_PLATFORM AND DEFINED ENV{LEXXOS_PLATFORM})
    set(LEXXOS_PLATFORM "$ENV{LEXXOS_PLATFORM}")
endif ()
if (NOT LEXXOS_BOARD AND DEFINED ENV{LEXXOS_BOARD})
    set(LEXXOS_BOARD "$ENV{LEXXOS_BOARD}")
endif ()

if (NOT LEXXOS_PLATFORM)
    if (COMMAND idf_build_process OR IDF_TARGET OR DEFINED ENV{IDF_TARGET}
            OR LEXXOS_BOARD MATCHES "^(m5stack_|jc_esp32p4_)"
            OR (NOT PROJECT_NAME AND (LEXXOS_IDF_PATH OR IDF_PATH
                    OR NOT "$ENV{LEXXOS_IDF_PATH}" STREQUAL "" OR NOT "$ENV{IDF_PATH}" STREQUAL "")))
        set(LEXXOS_PLATFORM espidf)
    elseif (PICO_BOARD OR COMMAND pico_sdk_init)
        set(LEXXOS_PLATFORM pico)
    endif ()
endif ()

if (LEXXOS_PLATFORM STREQUAL "espidf")
    if (PROJECT_NAME)
        set(LexxSDK_FOUND FALSE)
        set(LexxSDK_NOT_FOUND_MESSAGE "Find LexxSDK before project() in an ESP-IDF project")
        return()
    endif ()
    if (LEXXOS_BOARD)
        if (LEXXOS_BOARD MATCHES "^m5stack_cardputer(_adv)?$")
            set(_lexx_sdk_chip esp32s3)
        elseif (LEXXOS_BOARD STREQUAL "jc_esp32p4_m3_dev")
            set(_lexx_sdk_chip esp32p4)
        elseif (LEXXOS_BOARD STREQUAL "m5stack_basic_v1")
            set(_lexx_sdk_chip esp32)
        else ()
            set(LexxSDK_FOUND FALSE)
            set(LexxSDK_NOT_FOUND_MESSAGE "Unsupported ESP-IDF board: ${LEXXOS_BOARD}")
            return()
        endif ()
        if ((IDF_TARGET AND NOT IDF_TARGET STREQUAL _lexx_sdk_chip)
                OR (DEFINED ENV{IDF_TARGET} AND NOT "$ENV{IDF_TARGET}" STREQUAL "${_lexx_sdk_chip}"))
            set(LexxSDK_FOUND FALSE)
            set(LexxSDK_NOT_FOUND_MESSAGE "Board ${LEXXOS_BOARD} requires IDF_TARGET=${_lexx_sdk_chip}")
            return()
        endif ()
        set(IDF_TARGET "${_lexx_sdk_chip}" CACHE STRING "ESP-IDF target")
    endif ()
    include("${CMAKE_CURRENT_LIST_DIR}/LexxIDFConfig.cmake")
    set(ENV{_LEXX_SDK_BUILD_DIR} "${CMAKE_CURRENT_BINARY_DIR}/_lexxsdk")
    set(ENV{_LEXX_SDK_BOARD} "${LEXXOS_BOARD}")
    list(APPEND EXTRA_COMPONENT_DIRS "${_lexx_sdk_root}/ports/espidf/components/lexxos")
    add_library(LexxSDK::LexxSDK INTERFACE IMPORTED GLOBAL)
    target_link_libraries(LexxSDK::LexxSDK INTERFACE idf::lexxos)
    return()
endif ()

if (NOT CMAKE_CXX_COMPILER_LOADED)
    set(LexxSDK_FOUND FALSE)
    set(LexxSDK_NOT_FOUND_MESSAGE "Find LexxSDK after project() with CXX enabled")
    return()
endif ()

if (NOT LEXXOS_BOARD)
    if (LEXXOS_PLATFORM STREQUAL "pico")
        if (PICO_BOARD STREQUAL "pico_w")
            set(LEXXOS_BOARD picocalc_pico_w)
        elseif (PICO_BOARD STREQUAL "pico2")
            set(LEXXOS_BOARD picocalc_pico2)
        elseif (PICO_BOARD STREQUAL "pico2_w")
            set(LEXXOS_BOARD dev_pico2w)
        else ()
            set(LEXXOS_BOARD dev_pico)
        endif ()
    elseif (LEXXOS_PLATFORM STREQUAL "sim")
        set(LEXXOS_BOARD dev-sim)
    elseif (LEXXOS_PLATFORM STREQUAL "stm32f4")
        set(LEXXOS_BOARD euse_m4_demo_stm32f407)
    elseif (LEXXOS_PLATFORM STREQUAL "rk3506")
        set(LEXXOS_BOARD picocalc_lyra)
    else ()
        set(LEXXOS_BOARD host_native)
    endif ()
endif ()

function(_lexx_sdk_add_runtime source_dir)
    set(LEXXOS_SYSTEM_SDK ON)
    set(LEXXOS_EDITION standard)
    set(LEXXOS_RELEASE_ONLY OFF)
    set(LEXXOS_APPS OFF)
    set(LEXXOS_APPS_ONLY OFF)
    set(LEXXOS_HOST_NATIVE_ARCHITECTURE OFF)
    set(_LEXXOS_SDK_GENERATED_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/_lexxsdk/generated/include")
    add_subdirectory("${source_dir}" "${CMAKE_CURRENT_BINARY_DIR}/_lexxsdk" EXCLUDE_FROM_ALL)
endfunction()
_lexx_sdk_add_runtime("${_lexx_sdk_root}")
