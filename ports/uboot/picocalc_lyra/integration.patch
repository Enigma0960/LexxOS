@@ -5,3 +5,7 @@
 #
 
 obj-y	+= evb_rk3506.o
+
+ifndef CONFIG_SPL_BUILD
+obj-$(CONFIG_PICOCALC_LYRA_SPLASH) += picocalc_splash.o
+endif
