include_guard(GLOBAL)

# Профиль видят цель прошивки и потребители, которые линкуются с системным SDK.
function(lexxos_attach_memory_profile target)
    cmake_parse_arguments(PROFILE "" "CHIP;PLATFORM;BOARD" "" ${ARGN})
    if (PROFILE_UNPARSED_ARGUMENTS OR PROFILE_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid memory profile arguments: ${ARGN}")
    endif ()
    if (PROFILE_PLATFORM STREQUAL "pico" AND PROFILE_CHIP MATCHES "^(rp2040|rp2350)$")
        set(_platform_function applyPicoPlatform)
    elseif (PROFILE_PLATFORM STREQUAL "espidf" AND PROFILE_CHIP MATCHES "^(esp32|esp32s3|esp32p4)$")
        set(_platform_function applyEspIdfPlatform)
    elseif (PROFILE_PLATFORM STREQUAL "rk3506" AND PROFILE_CHIP STREQUAL "rk3506g2")
        set(_platform_function applyRk3506Platform)
    else ()
        message(FATAL_ERROR "Incompatible memory chip/platform: ${PROFILE_CHIP}/${PROFILE_PLATFORM}")
    endif ()
    if (PROFILE_BOARD)
        if (PROFILE_BOARD STREQUAL "picocalc_pico2w" AND PROFILE_CHIP STREQUAL "rp2350")
            set(_board_function applyPicoCalcPico2wBoard)
        elseif (PROFILE_BOARD STREQUAL "espidf_lcd" AND PROFILE_PLATFORM STREQUAL "espidf")
            set(_board_function applyEspIdfLcdBoard)
        elseif (PROFILE_BOARD STREQUAL "picocalc_lyra" AND PROFILE_CHIP STREQUAL "rk3506g2")
            set(_board_function applyPicoCalcLyraBoard)
        else ()
            message(FATAL_ERROR "Incompatible memory board: ${PROFILE_BOARD}/${PROFILE_CHIP}/${PROFILE_PLATFORM}")
        endif ()
    endif ()
    set(_chip_rp2040 applyRp2040Chip)
    set(_chip_rp2350 applyRp2350Chip)
    set(_chip_esp32 applyEsp32Chip)
    set(_chip_esp32s3 applyEsp32S3Chip)
    set(_chip_esp32p4 applyEsp32P4Chip)
    set(_chip_rk3506g2 applyRk3506g2Chip)
    set(_includes "#include <memory/chips/${PROFILE_CHIP}.h>\n#include <memory/platforms/${PROFILE_PLATFORM}.h>\n")
    set(_apply "    profiles::${_chip_${PROFILE_CHIP}}(profile);\n    profiles::${_platform_function}(profile);\n")
    if (PROFILE_BOARD)
        string(APPEND _includes "#include <memory/boards/${PROFILE_BOARD}.h>\n")
        string(APPEND _apply "    profiles::${_board_function}(profile);\n")
    endif ()
    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/memory-profiles/${target}")
    file(MAKE_DIRECTORY "${_generated}")
    # configure_file сохраняет timestamp, если композиция не изменилась.
    set(_template "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/runtime_memory_profile.h.in")
    configure_file("${_template}" "${_generated}/lexxos_target_memory_profile.h" @ONLY)
    set(_scope PRIVATE)
    if (LEXXOS_SYSTEM_SDK)
        set(_scope PUBLIC)
    endif ()
    target_include_directories(${target} ${_scope} "${_generated}")
    if (PROFILE_PLATFORM STREQUAL "espidf")
        # SDK должен находить собственные FreeRTOSConfig.h/lwipopts.h до config/.
        target_include_directories(${target} SYSTEM ${_scope} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../")
    else ()
        target_include_directories(${target} ${_scope} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../")
    endif ()
    target_compile_definitions(${target} ${_scope}
            LEXXOS_RUNTIME_PROFILE_HEADER="lexxos_target_memory_profile.h")
    # Флаги совместимости нужны SDK heap-конфигурации и контрактным проверкам;
    # runtime-заголовки больше не выбирают и не объединяют слои по этим флагам.
    foreach (_layer IN ITEMS CHIP PLATFORM BOARD)
        if (PROFILE_${_layer})
            string(TOUPPER "${PROFILE_${_layer}}" _name)
            target_compile_definitions(${target} ${_scope} "LEXXOS_MEMORY_${_layer}_${_name}=1")
        endif ()
    endforeach ()
endfunction()

# Compile-time profile selection is private to each firmware/component target.
# Do not apply these flags globally: host tests and tools must use base defaults.
function(lexxos_attach_sdk_memory_profile target)
    set(_board)
    if (LEXXOS_PLATFORM STREQUAL "pico")
        if (PICO_PLATFORM STREQUAL "rp2040")
            set(_chip rp2040)
        elseif (PICO_PLATFORM STREQUAL "rp2350-arm-s")
            set(_chip rp2350)
        else ()
            message(FATAL_ERROR "Unsupported Pico memory profile for PICO_PLATFORM='${PICO_PLATFORM}'")
        endif ()

        if (LEXXOS_BOARD STREQUAL "picocalc_pico2w" OR LEXXOS_BOARD STREQUAL "picocalc_pico2")
            if (NOT PICO_PLATFORM STREQUAL "rp2350-arm-s")
                message(FATAL_ERROR "PicoCalc Pico2 memory profile requires an RP2350 ARM SDK target")
            endif ()
            set(_board picocalc_pico2w)
        endif ()
    elseif (LEXXOS_PLATFORM STREQUAL "espidf")
        if (IDF_TARGET STREQUAL "esp32")
            set(_chip esp32)
        elseif (IDF_TARGET STREQUAL "esp32s3")
            set(_chip esp32s3)
        elseif (IDF_TARGET STREQUAL "esp32p4")
            set(_chip esp32p4)
        else ()
            message(FATAL_ERROR "Unsupported ESP-IDF memory profile for IDF_TARGET='${IDF_TARGET}'")
        endif ()
        if (LEXXOS_BOARD STREQUAL "m5stack_cardputer"
                OR LEXXOS_BOARD STREQUAL "m5stack_cardputer_adv"
                OR LEXXOS_BOARD STREQUAL "jc_esp32p4_m3_dev")
            set(_board espidf_lcd)
        endif ()
    else ()
        message(FATAL_ERROR "SDK memory profile requested for unsupported LEXXOS_PLATFORM='${LEXXOS_PLATFORM}'")
    endif ()
    set(_board_args)
    if (_board)
        set(_board_args BOARD "${_board}")
    endif ()
    lexxos_attach_memory_profile(${target} CHIP "${_chip}" PLATFORM "${LEXXOS_PLATFORM}" ${_board_args})
endfunction()
