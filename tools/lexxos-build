@dataclass(frozen=True)
class BuildProfile:
    name: str
    configure_preset: str
    build_preset: str
    description: str
    platform: str
    board: str
    features: tuple[str, ...] = ()
    requires_espidf: bool = False
    flash_preset: str | None = None
    app_flash_preset: str | None = None


@dataclass(frozen=True)
class PreflightCheck:
    name: str
    ok: bool
    detail: str


