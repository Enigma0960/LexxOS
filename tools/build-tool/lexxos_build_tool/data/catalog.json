  "platforms": [
    {
      "key": "host",
      "label": "Host native",
      "cmakePlatform": "host",
      "defaultBoard": "host_native",
      "defaultBuildDir": "build/configurator/host",
      "defaultCMakeOptions": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEXXOS_BUILD_FLAVOR": "standard"
      },
      "visibleGroups": [
        "common",
        "features"
      ],
      "instructions": "Host build does not need an embedded SDK. Open the repository root in CLion. Use the generated CMake command only if you want a custom build directory or custom feature set.",
      "presets": [
        {
          "label": "debug-host",
          "configurePreset": "debug-host",
          "buildTarget": "debug-host"
        },
        {
          "label": "debug-host-full",
          "configurePreset": "debug-host-full",
          "buildTarget": "debug-host-full"
        },
        {
          "label": "manual",
          "configurePreset": "",
          "notes": "Generate a custom configure command"
        }
      ]
    },
    {
      "key": "sim",
      "label": "Simulator",
      "cmakePlatform": "sim",
      "defaultBoard": "dev-sim",
      "defaultBuildDir": "build/configurator/sim",
      "defaultCMakeOptions": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEXXOS_BUILD_FLAVOR": "standard"
      },
      "visibleGroups": [
        "common",
        "features"
      ],
      "instructions": "Simulator build produces a host shared library used by the Python emulator. Use CLion root project profile debug-sim for regular development.",
