{
  "id": "picocalc_pico2w",
  "name": "ClockworkPi PicoCalc / Pico 2 W (JCS keyboard)",
  "platform": "pico",
  "preset": "manual",
  "buildDir": "build/configurator/picocalc-pico2w-jcs",
  "userPresetName": "user-pico-picocalc_pico2w_jcs",
  "cmakeDefaults": {
    "PICO_BOARD": "pico2_w",
    "LEXXOS_PICOCALC_KEYBOARD_FIRMWARE": "jcs"
  },
  "featureDefaults": {
    "LEXXOS_PICO_USE_FREERTOS": "ON",
    "LEXXOS_FEATURE_DISPLAY": "ON",
    "LEXXOS_FEATURE_KEYBOARD": "ON",
    "LEXXOS_FEATURE_SD_CARD": "ON",
    "LEXXOS_FEATURE_FATFS": "ON",
    "LEXXOS_FEATURE_PSRAM": "ON",
    "LEXXOS_ENABLE_GAMEBOY": "OFF"
  }
}
